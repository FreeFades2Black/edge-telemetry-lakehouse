[spartanburg_plant]
%{ for name, gw in edge_gateways ~}
%{ if can(regex("sptn|spartanburg", lower(gw.facility_id))) || can(regex("sptn", lower(name))) ~}
${name} ansible_host=${gw.ip} plant_location=${gw.plant_location} primary_machine=${gw.primary_machine} facility_id=${gw.facility_id}%{ if gw.connection_type == "local" } ansible_connection=local%{ endif }
%{ endif ~}
%{ endfor ~}

[greer_plant]
%{ for name, gw in edge_gateways ~}
%{ if can(regex("greer|bmw", lower(gw.facility_id))) || can(regex("greer", lower(name))) ~}
${name} ansible_host=${gw.ip} plant_location=${gw.plant_location} primary_machine=${gw.primary_machine} facility_id=${gw.facility_id}%{ if gw.connection_type == "local" } ansible_connection=local%{ endif }
%{ endif ~}
%{ endfor ~}

[greenville_plant]
%{ for name, gw in edge_gateways ~}
%{ if (can(regex("gvl|greenville|marc|gev", lower(gw.facility_id))) || can(regex("gvl", lower(name)))) && name != "omarchy" ~}
${name} ansible_host=${gw.ip} plant_location=${gw.plant_location} primary_machine=${gw.primary_machine} facility_id=${gw.facility_id}%{ if gw.connection_type == "local" } ansible_connection=local%{ endif }
%{ endif ~}
%{ endfor ~}

[omarchy_edge]
%{ for name, gw in edge_gateways ~}
%{ if name == "omarchy" || can(regex("omarchy", lower(gw.facility_id))) ~}
${name} ansible_host=${gw.ip} plant_location=${gw.plant_location} primary_machine=${gw.primary_machine} facility_id=${gw.facility_id}%{ if gw.connection_type == "local" } ansible_connection=local%{ endif }
%{ endif ~}
%{ endfor ~}

[factory_edge_gateways:children]
